# 只填写到本地 .env，切勿提交或放进小程序代码。
DASHSCOPE_API_KEY=
# Vercel 中已使用的变量名；非空时优先读取它。密钥只供后端使用。
aliyun=
DASHSCOPE_WORKSPACE_ID=
QWEN_MODEL=qwen3.8-omni-flash-realtime
# 音色按角色在 config/characters.json 维护，不再使用全局 QWEN_VOICE。

# 默认仅本机可访问。部署后设置实际 HTTPS 域名。
HOST=127.0.0.1
PORT=8788
PUBLIC_ORIGIN=
# 可选：自己指定一个至少24字符的应用访问口令；留空会生成并保存到.local。
APP_ACCESS_TOKEN=

MAX_SESSION_SECONDS=600
MAX_IDLE_SECONDS=60
DAILY_BUDGET_YUAN=3
MONTHLY_BUDGET_YUAN=50
ENABLE_INPUT_TRANSCRIPTION=true
# 口语停顿初值，后续根据真机体验调整。
VAD_SILENCE_MS=1400
