page { background:#f5f5f7; color:#20232b; }
.practice-page { padding:28rpx 32rpx 42rpx; padding-bottom:calc(42rpx + env(safe-area-inset-bottom)); }
button { margin:0; -webkit-tap-highlight-color:transparent; }
.scene-card,.free-card { width:100%!important;min-width:0; }
.home-screen { padding-bottom:140rpx; }
.home-top { display:flex; align-items:center; justify-content:space-between; margin:0 0 34rpx; }
.brand { display:flex; align-items:center; gap:10rpx; font-size:34rpx; font-weight:800; letter-spacing:-1rpx; }.brand-dot { width:12rpx;height:12rpx;border-radius:50%;background:#2667ff; }
.profile-button { position:relative;width:68rpx!important;height:68rpx;background:#eaeaf0;border-radius:50%;padding:0; }.profile-head { width:16rpx;height:16rpx;position:absolute;left:26rpx;top:16rpx;border-radius:50%;border:3rpx solid #70727e; }.profile-body { position:absolute;left:18rpx;top:37rpx;width:32rpx;height:17rpx;border:3rpx solid #70727e;border-bottom:0;border-radius:22rpx 22rpx 0 0; }
.home-tabs { display:flex;background:#e9e9ed;padding:7rpx;border-radius:22rpx;gap:6rpx; }.home-tab { flex:1;background:transparent;color:#82828c;font-size:28rpx;font-weight:650;padding:17rpx 0;border-radius:16rpx; }.home-tab.is-selected { background:#fff;color:#24252d;box-shadow:0 3rpx 8rpx #1a214008; }
.home-heading { font-size:38rpx;font-weight:750;letter-spacing:-1rpx;margin:40rpx 0 12rpx; }.home-subheading { font-size:25rpx;color:#8b8c96;line-height:1.6;margin-bottom:29rpx; }
.scene-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22rpx; }.scene-card { padding:0;overflow:hidden;text-align:left;border-radius:29rpx;background:#fff;box-shadow:0 6rpx 18rpx #1c214604; }.scene-art { position:relative;height:304rpx;overflow:hidden;background:#eeedf6; }.atlas-image { position:absolute;width:300%;height:200%;max-width:none; }.scene-card-copy { padding:22rpx 23rpx 18rpx; }.scene-title { font-size:29rpx;font-weight:750;letter-spacing:-.6rpx; }.scene-english { font-size:19rpx;color:#92929c;margin-top:5rpx;min-height:29rpx; }.scene-card-footer { display:flex;align-items:center;justify-content:space-between;margin-top:17rpx;color:#898b95;font-size:20rpx; }.circle-arrow { width:40rpx;height:40rpx;line-height:38rpx;border-radius:50%;background:#f1f2f6;color:#4e535e;font-size:26rpx;text-align:center; }
.service-link { display:flex;align-items:center;justify-content:center;gap:9rpx;background:transparent;padding:29rpx 0 0;color:#9899a4;font-size:21rpx; }.status-dot { width:9rpx;height:9rpx;border-radius:50%;background:#c0a779; }.status-dot.connected { background:#54ab8a; }.service-arrow { font-size:28rpx;margin-left:5rpx; }
.free-card { background:#eee9fb;overflow:hidden;border-radius:32rpx;text-align:left;padding:0; }.free-art { position:relative;height:520rpx;overflow:hidden; }.free-copy { background:#fff;padding:35rpx; }.free-title { font-size:36rpx;font-weight:750; }.free-description { font-size:25rpx;color:#90909d;margin-top:12rpx; }.free-cta { display:flex;justify-content:space-between;margin-top:32rpx;color:#2667ff;font-size:28rpx;font-weight:650; }.free-note { margin-top:25rpx;color:#92939e;text-align:center;font-size:22rpx;line-height:1.7; }
.bottom-nav { position:fixed;z-index:8;bottom:0;left:0;right:0;display:flex;justify-content:space-around;padding:16rpx 60rpx calc(16rpx + env(safe-area-inset-bottom));border-top:1rpx solid #eeeef2;background:#fffffff5; }.nav-item { width:160rpx!important;background:transparent;color:#aaaab5;font-size:21rpx;padding:0; }.nav-active { color:#2764f2; }.nav-speech,.nav-person { font-size:37rpx;line-height:43rpx;font-weight:600; }.nav-item text { display:block;margin-top:5rpx; }
.page-top { display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-bottom:25rpx;min-height:64rpx; }.back-button { width:64rpx!important;height:64rpx;line-height:55rpx;padding:0;background:#fff;border-radius:50%;font-size:49rpx;font-family:Arial,sans-serif;color:#454753;flex-shrink:0; }.top-title { flex:1;font-size:27rpx;font-weight:650; }.top-tag { color:#93949f;font-size:22rpx; }
.detail-hero { position:relative;height:520rpx;border-radius:32rpx;overflow:hidden;background:#edebf4; }.hero-label { position:absolute;left:25rpx;bottom:24rpx;padding:11rpx 18rpx;border-radius:20rpx;background:#ffffffdf;font-size:21rpx;letter-spacing:.5rpx;color:#525263; }.detail-heading { font-size:43rpx;font-weight:750;margin:30rpx 0 12rpx;letter-spacing:-1rpx; }.detail-description { color:#868895;font-size:26rpx;line-height:1.75; }
.partner-row { display:flex;align-items:center;gap:18rpx;margin:28rpx 0; }.partner-avatar { display:flex;align-items:center;justify-content:center;width:74rpx;height:74rpx;border-radius:24rpx;background:#e6eafe;color:#4669da;font-size:30rpx;font-weight:750; }.partner-name { font-size:26rpx;font-weight:650; }.partner-role { color:#9294a0;font-size:21rpx;margin-top:6rpx; }.partner-badge { margin-left:auto;padding:10rpx 16rpx;border-radius:16rpx;background:#eaeefc;color:#6c7aaf;font-size:20rpx; }
.task-panel { background:#fff;border-radius:25rpx;padding:28rpx; }.block-title { font-size:27rpx;font-weight:700;margin-bottom:24rpx; }.task-row { display:flex;gap:16rpx;align-items:flex-start;margin-bottom:19rpx;font-size:25rpx;line-height:1.6;color:#606271; }.task-number { width:35rpx;height:35rpx;line-height:35rpx;flex-shrink:0;border-radius:50%;background:#f1f3fa;text-align:center;font-size:20rpx;color:#737f9a; }.task-note { color:#a3a4ae;font-size:20rpx;border-top:1rpx solid #f1f1f5;padding-top:20rpx;margin-top:6rpx; }
.preferences { margin:27rpx 0; }.preference { display:flex;justify-content:space-between;align-items:center;margin-top:16rpx;font-size:24rpx;color:#747682; }.preference>text { margin-right:25rpx;flex-shrink:0; }.segments { display:flex;flex:1;max-width:445rpx;padding:5rpx;gap:5rpx;border-radius:16rpx;background:#e9e9ef; }.segment { flex:1;min-width:0;white-space:nowrap;padding:11rpx 14rpx;font-size:22rpx;color:#91939e;background:transparent;border-radius:12rpx; }.segment.chosen { background:#fff;color:#4b566e;box-shadow:0 2rpx 6rpx #343f6b05; }
.start-button { background:#2865f5;color:#fff;padding:25rpx;border-radius:23rpx;font-size:28rpx;font-weight:650;display:flex;justify-content:center;align-items:center;gap:22rpx;box-shadow:0 8rpx 20rpx #2667ff15; }.start-button text { font-size:32rpx;line-height:1; }.detail-bottom { display:flex;align-items:center;justify-content:space-between;margin-top:18rpx;color:#a0a1ab;font-size:20rpx; }.detail-bottom button { background:transparent;color:#6c83b6;font-size:21rpx;padding:8rpx 0; }.setup-note { margin-top:15rpx;background:#eeeef3;color:#8d8c99;text-align:left;padding:18rpx;border-radius:17rpx;font-size:21rpx;line-height:1.8; }.setup-note text { display:block;color:#6a7fae; }
.is-call { padding-bottom:calc(34rpx + env(safe-area-inset-bottom)); }.call-top { margin-bottom:26rpx; }.call-heading { flex:1;font-size:26rpx;font-weight:650; }.call-timer { font-size:21rpx;letter-spacing:1.5rpx;font-weight:400;font-variant-numeric:tabular-nums;color:#91949f;margin-top:4rpx; }.mode-toggle { font-size:22rpx;border-radius:18rpx;padding:13rpx 17rpx;background:#fff;color:#6f778b; }
.scene-stage { height:660rpx;position:relative;overflow:hidden;border-radius:34rpx;background:#e9e9f3; }.scene-portrait { position:absolute;inset:0;transform:scale(1.015);transition:transform 1.4s ease; }.state-listening .scene-portrait { animation:scene-breathe 4.2s ease-in-out infinite; }.state-speaking .scene-portrait { animation:scene-breathe 2.5s ease-in-out infinite; }.scene-stage-shade { position:absolute;inset:0;background:linear-gradient(180deg,transparent 65%,#24223088 100%); }.scene-partner { position:absolute;bottom:34rpx;left:30rpx;color:#fff; }.scene-partner-name { font-size:35rpx;font-weight:750;text-shadow:0 1rpx 12rpx #0002; }.scene-partner-role { font-size:21rpx;color:#ffffffc9;margin-top:6rpx; }.voice-indicator { position:absolute;right:32rpx;bottom:42rpx;display:flex;align-items:center;justify-content:center;gap:5rpx;width:80rpx;height:58rpx;border-radius:20rpx;background:#ffffff38; }.voice-indicator view { width:5rpx;height:10rpx;border-radius:5rpx;background:#fff; }.state-speaking .voice-indicator view { animation:voice-wave .8s ease-in-out infinite alternate; }.state-listening .voice-indicator view { animation:voice-wave 1.7s ease-in-out infinite alternate; }.voice-indicator view:nth-child(2) { animation-delay:.16s; }.voice-indicator view:nth-child(3) { animation-delay:.32s; }.voice-indicator view:nth-child(4) { animation-delay:.12s; }.voice-indicator view:nth-child(5) { animation-delay:.28s; }.reduced-motion .scene-portrait,.reduced-motion .voice-indicator view { animation:none; }
@keyframes scene-breathe { 0%,100% { transform:scale(1.015); }50% { transform:scale(1.035); } }@keyframes voice-wave { from { height:9rpx; }to { height:30rpx; } }
.orb-stage { padding-top:40rpx; }.voice-orb-wrap { position:relative;height:490rpx;display:flex;align-items:center;justify-content:center; }.voice-orb { position:absolute;width:100%;height:100%;opacity:0; }.voice-orb.ready { opacity:1; }.orb-fallback { width:340rpx;height:340rpx;border-radius:50%;background:radial-gradient(ellipse at 32% 18%,#fff 0%,#ffffffb3 24%,transparent 52%),radial-gradient(ellipse at 80% 80%,#326aff 0%,#65b7ff 28%,transparent 60%),radial-gradient(ellipse at 28% 65%,#4480f7 0%,#91d2ff 40%,#effaff 78%);box-shadow:inset 0 0 32rpx #ffffffc9,0 10rpx 35rpx #97c3eb2b; }.orb-partner { color:#a1a4b0;text-align:center;font-size:22rpx;margin:20rpx 0 48rpx; }.mode-orb { background:linear-gradient(180deg,#f5f5f7 0%,#f9fbff 58%,#f5f5f7 100%); }
.state-title { text-align:center;font-size:32rpx;font-weight:700;margin-top:32rpx; }.state-hint { text-align:center;font-size:22rpx;color:#9295a2;line-height:1.65;margin:13rpx 5rpx 0;min-height:38rpx; }.call-tools { display:flex;align-items:center;justify-content:center;gap:20rpx;margin:22rpx 0 20rpx; }.mini-tool { background:transparent;color:#9296a4;font-size:20rpx;padding:8rpx 0; }.tool-selected { color:#456cc5; }.call-actions { display:flex;align-items:center;justify-content:center;gap:64rpx;padding:19rpx 0 9rpx; }.call-tool,.hangup { width:112rpx!important;padding:0;background:transparent;font-size:21rpx;color:#8d92a0;text-align:center; }.tool-symbol { width:94rpx;height:94rpx;line-height:92rpx;margin:0 auto 12rpx;border-radius:50%;background:#e9ebf1;color:#697385;font-size:33rpx; }.muted-tool .tool-symbol { background:#f7e6e7;color:#c67479; }.hangup-symbol { width:106rpx;height:106rpx;line-height:96rpx;margin:0 auto 12rpx;border-radius:50%;background:#ee666c;color:#fff;font-size:55rpx; }.hangup { color:#c7797d; }.call-start { margin-top:28rpx; }.usage { text-align:center;color:#8c94a5;font-size:21rpx;margin-top:26rpx; }.usage text { color:#a7acb6;margin-left:9rpx; }.footnote,.orb-static-note { color:#b0b3bd;text-align:center;font-size:19rpx;margin-top:19rpx;line-height:1.6; }
.message { margin-top:22rpx;border-radius:18rpx;padding:20rpx 24rpx;font-size:24rpx;line-height:1.65; }.error { background:#fff0ec;color:#a85f57; }.notice { background:#eaf0fa;color:#737f99; }.error-links { display:flex;gap:30rpx; }.error-links button { padding:9rpx 0 0;background:transparent;color:#a85f57;font-size:21rpx;text-decoration:underline; }
.subtitles { background:#fff;border-radius:24rpx;padding:25rpx;margin:20rpx 0 13rpx; }.subtitle-heading { font-size:24rpx;color:#636d82;display:flex;justify-content:space-between; }.subtitle-heading text { font-size:20rpx;color:#a6a9b4; }.transcript-list { height:300rpx;margin-top:24rpx; }.subtitle { font-size:27rpx;line-height:1.65;margin-bottom:23rpx;white-space:pre-wrap;color:#485469; }.speaker { color:#8c98b0;font-size:19rpx;margin-bottom:5rpx; }.subtitle.user { color:#8b91a2; }.empty-transcript { color:#a4a9b4;font-size:23rpx;line-height:1.8;padding:28rpx 0 8rpx; }
.privacy-mask { position:fixed;inset:0;z-index:20;background:#1d253977;display:flex;justify-content:center;align-items:center;padding:40rpx; }.privacy-dialog { background:#fff;border-radius:28rpx;padding:35rpx;width:100%; }.privacy-title { font-size:30rpx;font-weight:650; }.privacy-copy { color:#82899a;font-size:25rpx;line-height:1.9;margin-top:20rpx; }.privacy-contract { color:#5377b8;font-size:24rpx;background:transparent;padding:20rpx 0;text-align:left; }.privacy-actions { display:flex;gap:15rpx;margin-top:15rpx; }.privacy-actions button { flex:1;font-size:25rpx;padding:21rpx 10rpx; }.privacy-actions .primary { background:#2865f5; }.privacy-actions .secondary { background:#eeeff5;color:#717a8d; }

/* The 3×2 atlas is square; each 2:3 cell is cover-cropped without distorting its characters. */
.atlas-cell { position:absolute;left:0;top:0;width:100%;height:1029rpx;overflow:hidden; }
.scene-art .atlas-cell { height:498rpx; }
.profile-button { margin:0!important; }

.free-orb-art { display:flex;align-items:center;justify-content:center;background:linear-gradient(160deg,#f8fbff,#e9f2ff); }

/* Full-bleed 2:3 scene cards, matching the selected reference. */
.scene-card { position:relative;height:498rpx;border-radius:46rpx;background:#7f7166;color:#fff; }
.scene-art { position:absolute;left:0;top:0;right:0;bottom:0;height:100%; }
.scene-card-shade { position:absolute;inset:0;background:linear-gradient(180deg,transparent 36%,#10141b19 58%,#101621de 100%); }
.scene-tag { position:absolute;left:20rpx;top:21rpx;padding:8rpx 14rpx;border-radius:24rpx;background:#fffffff0;color:#50525d;font-size:18rpx;line-height:1.4;font-weight:600; }
.scene-card-copy { position:absolute;left:27rpx;right:38rpx;bottom:47rpx;padding:0;color:#fff; }
.scene-title { font-size:19rpx;line-height:1.5;font-weight:500;color:#ffffffe3;letter-spacing:.4rpx;margin-bottom:10rpx; }
.scene-english { margin:0;color:#fff;font-size:35rpx;line-height:1.16;font-weight:600;letter-spacing:-.6rpx;min-height:0; }
.scene-card>.circle-arrow { position:absolute;right:21rpx;bottom:15rpx;width:30rpx;height:30rpx;line-height:30rpx;border-radius:0;background:transparent;color:#fff;font-size:29rpx; }

/* Display the same character profile used by the conversation service. */
.character-profile { margin:0 0 26rpx;padding:27rpx 28rpx;border:1rpx solid #e5e9f0;border-radius:25rpx;background:#ffffffc9; }.character-profile-heading { display:flex;justify-content:space-between;align-items:center;gap:20rpx;color:#44546c;font-size:26rpx;font-weight:650; }.character-profile-heading>text { font-size:19rpx;color:#96a3b6;font-weight:400; }.character-tags { display:flex;flex-wrap:wrap;gap:10rpx;margin-top:20rpx; }.character-tags text { padding:7rpx 15rpx;border-radius:25rpx;font-size:20rpx;background:#edf3fd;color:#6a86b1; }.character-bio { font-size:24rpx;line-height:1.8;color:#77859a;margin:23rpx 0; }.character-facts { padding-top:20rpx;border-top:1rpx solid #ecf0f5; }.character-facts>view { display:flex;gap:23rpx;font-size:22rpx;color:#8090a8;line-height:1.8;margin-bottom:8rpx; }.character-facts>view:last-child { margin-bottom:0; }.character-fact-label { flex-shrink:0;color:#a2acba; }.subtitle-heading { gap:15rpx;flex-wrap:wrap; }.partner-row>view:nth-child(2) { min-width:0; }.partner-role { line-height:1.7; }.partner-avatar,.partner-badge { flex-shrink:0; }
