.settings-page { padding-top: 42rpx; }
.title { font-size: 40rpx; font-weight: 700; margin-top: 21rpx; }
.intro { color: #7a8c85; font-size: 26rpx; line-height: 1.8; margin: 16rpx 0 34rpx; }
.label { font-size: 28rpx; font-weight: 650; margin-bottom: 17rpx; }.second-label { margin-top: 34rpx; }
.field { height: 92rpx; padding: 20rpx; border: 2rpx solid #e1eae5; background: #f8faf9; border-radius: 16rpx; font-size: 27rpx; width: 100%; }
.help { color: #85958e; font-size: 23rpx; line-height: 1.75; margin-top: 12rpx; }
.password-row { display: flex; align-items: center; gap: 14rpx; }.token { flex: 1; min-width: 0; width: 0; }.reveal { flex-shrink: 0; background: transparent; color: #507b69; padding: 20rpx 3rpx; font-size: 25rpx; }
.actions { display: flex; gap: 16rpx; margin-top: 38rpx; }.actions button { flex: 1; padding: 24rpx 10rpx; font-size: 26rpx; }
.result { border-radius: 16rpx; padding: 20rpx; margin-top: 25rpx; font-size: 24rpx; line-height: 1.7; }.ok { color: #3d7558; background: #edf7ee; }.pending { color: #9a713e; background: #f9f2e8; }
.model { margin-top: 15rpx; font-size: 20rpx; color: #8ca097; word-break: break-all; }
.instructions { margin-top: 27rpx; }.section-title { font-size: 28rpx; font-weight: 650; }.step { display: flex; gap: 20rpx; margin-top: 28rpx; }.number { width: 40rpx; height: 40rpx; flex-shrink: 0; border-radius: 50%; background: #eaf2ed; color: #577b67; font-size: 23rpx; text-align: center; line-height: 40rpx; }.step-title { font-size: 26rpx; color: #3f6255; }
.privacy { font-size: 22rpx; line-height: 1.8; color: #8c9c94; padding: 27rpx 8rpx 13rpx; }.clear { background: transparent; color: #8b9d92; font-size: 23rpx; padding: 18rpx; }
.orb-credit { margin-top: 28rpx; padding: 26rpx 8rpx 8rpx; border-top: 1rpx solid #e1eae5; color: #85958e; font-size: 22rpx; text-align: center; }
.source-link { background: transparent; color: #507b69; font-size: 23rpx; padding: 16rpx 12rpx; text-decoration: underline; }
/* Shared neutral/blue palette with the practice pages. */
page { background:#f5f5f7;color:#242832; }
.eyebrow,.intro,.help,.model,.privacy,.clear,.orb-credit { color:#9295a3; }
.field { background:#f8f8fb;border-color:#e8e9ef; }
.reveal,.source-link,.step-title { color:#617eae; }
.number { background:#eaf0fc;color:#6a81b2; }
.actions .primary { background:#2865f5; }
.actions .secondary { background:#e9edf6;color:#65748e; }
